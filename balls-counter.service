[Unit]
Description=Ball Counter - FIRST Robotics ball scoring vision system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/balls-counter
EnvironmentFile=%h/projects/balls-counter/balls-counter.env
ExecStart=%h/.local/bin/uv run --extra web --extra ml ball-counter ${CONFIG} --web-port ${WEB_PORT} --yolo-model ${YOLO_MODEL} --require-gpu
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=balls-counter

[Install]
WantedBy=default.target
